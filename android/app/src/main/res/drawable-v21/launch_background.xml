<?xml version="1.0" encoding="utf-8"?>
<!--
  Variante para API 21+. Debe pintar lo mismo que drawable/launch_background.xml.

  El template usa aquí ?android:colorBackground, que sigue el tema del sistema
  y por tanto sale blanco en claro y negro en oscuro. Taylor arranca siempre en
  rosa, independientemente del tema del dispositivo: el splash es identidad de
  marca, no interfaz.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/taylor_raspberry" />
</layer-list>
